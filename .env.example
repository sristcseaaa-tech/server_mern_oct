# Content DB — homepage/customize data
MONGODB_URI=mongodb://127.0.0.1:27017/srist
# Auth DB — user accounts (can be the same cluster, different db name, or a fully separate cluster)
AUTH_MONGODB_URI=mongodb://127.0.0.1:27017/srist-auth
# Student sign-up DB — one record per student sign-up form submission
STUDENT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# STUDENT_DB_NAME=srist-students
PORT=5000
# The website address(es) allowed to call this API (comma-separated, no path). Local dev: the Vite address.
# Production (Render): your Vercel address, e.g.  CLIENT_ORIGIN=https://srist.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Production (Render) only:
#   NODE_ENV=production
#   ALLOW_VERCEL_PREVIEWS=true     # optional: also accept https://<anything>.vercel.app preview deployments
JWT_SECRET=replace-with-a-long-random-string

# Gmail SMTP — used to send email-verification links (Nodemailer)
# EMAIL_USER = the Gmail address sending the emails
# EMAIL_APP_PASSWORD = a 16-character Gmail "App Password", NOT the normal
#   Gmail login password. Create one at myaccount.google.com/apppasswords
#   (requires 2-Step Verification enabled on that Gmail account first).
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your16charapppassword

# Admin access to /customize is automatic for any email matching
# <anything>.admin@gmail.com (e.g. abi.admin@gmail.com). No env var needed —
# see server/utils/isAdminEmail.js.

# ---- Admission enquiries (/apply) -> Google Sheet + emails ----
# 1) Put your Google service-account key at server/credentials.json (git-ignored),
#    or set GOOGLE_CREDENTIALS_JSON (raw or base64 JSON) when hosting
#    (Render/Vercel have no credentials.json — the env var is the only way).
#    Make base64:  base64 -w0 credentials.json   (macOS: base64 -i credentials.json)
# 2) Share the spreadsheet with the service account's client_email as "Editor".
GOOGLE_SHEET_ID=1UNNLeyFqfyEnFHfZSYbxS22DZpUcNag0CdaQqTOjHXY
# Tab (worksheet) inside that spreadsheet. Created automatically if missing.
# NOTE: a new spreadsheet opens on a tab called "Sheet1" — rows go into the
# "Applications" tab (look at the tab strip at the bottom), unless you set
# this to Sheet1 to fill the first tab instead.
GOOGLE_SHEET_TAB=Applications
# Where the "new enquiry" email goes (defaults to EMAIL_USER)
SRIST_NOTIFY_EMAIL=info@srist.in

# --- Assessments ---
# File storage for assessment attachments and student uploads (Cloudinary).
# Copy the "API environment variable" from your Cloudinary dashboard. Keep it secret.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Running student code (C / C++ / Python). Pick ONE:
#   JUDGE0_URL=https://your-judge0-host          (add JUDGE0_KEY if it needs a key)
#   PISTON_URL=https://your-piston-host/api/v2
#   CODE_RUNNER=local     # development only: runs gcc / g++ / python3 on THIS machine.
#                         # Student code can read this server's files (incl. .env), so it is
#                         # refused when NODE_ENV=production. Use JUDGE0_URL / PISTON_URL live.
#
# Google Sheets: each assessment can send students' text answers to its own sheet. It uses the
# same service account as the admissions sheet (GOOGLE_CREDENTIALS_JSON / credentials.json);
# enable the "Google Sheets API" and "Google Drive API" for that Google Cloud project.

# --- Assessment FILES -> Google Drive (any file type: pdf, image, zip, docs, text …) ---
# Students upload in the portal; the server saves each file into a PRIVATE Drive folder for that
# assessment (one sub-folder per student). Only the assessment provider (the teacher who made it,
# plus staff added in the Drive panel) can open that folder or the answers Sheet. Students never
# get a Drive link. Multiple-choice + written answers go to the assessment's Google Sheet.
#
# Credential source (checked in this order — put the files in server/credentials/, git-ignored):
#   1. OAuth  (recommended): oauth-client.json (the Google "client_secret…json") + drive-token.json
#        npm run drive:auth     <- one-time sign-in with the account that should OWN the files
#        Hosting: GOOGLE_OAUTH_CLIENT_JSON=<raw or base64 client JSON>  GOOGLE_DRIVE_REFRESH_TOKEN=<token>
#   2. Service account: drive-service-account.json  (or GOOGLE_DRIVE_CREDENTIALS_JSON=<raw/base64>)
#        Needs GOOGLE_DRIVE_ROOT_FOLDER_ID = a folder on a Google Workspace SHARED DRIVE where the
#        service account is a Content manager (a service account has no storage of its own).
# GOOGLE_DRIVE_AUTH=auto                 # auto | oauth | service_account
# GOOGLE_DRIVE_ROOT_FOLDER_ID=           # optional with OAuth (default: a "SRIST Assessments" folder is created)
# ASSESSMENT_FILE_STORAGE=auto           # auto (Drive when usable, else Cloudinary) | drive | cloudinary
# Enable "Google Drive API" + "Google Sheets API" in Google Cloud, then:  npm run check:drive
